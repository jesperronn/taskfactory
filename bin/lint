#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: bin/lint [--autofix] [PATH...]" >&2
  echo "       bin/lint --tells" >&2
  echo "       bin/lint --readability" >&2
}

start_dir=$PWD
cd "$(dirname "${BASH_SOURCE[0]}")/.."
repo_root=$PWD

# tasks_dir: where the task folders live, a slash path relative to the repository
# root. It is the top-level tasks_dir key of .taskfactory/config.toml, or "tasks"
# when the file or the key is absent. taskfactory validates the value; this is
# only a read of it.
tasks_dir=tasks
if [[ -f .taskfactory/config.toml ]]; then
  configured=$(sed -n 's/^[[:space:]]*tasks_dir[[:space:]]*=[[:space:]]*"\([^"]*\)".*$/\1/p;/^[[:space:]]*\[/q' \
    .taskfactory/config.toml | head -n 1)
  configured=${configured#./}
  configured=${configured%/}
  if [[ -n $configured ]]; then tasks_dir=$configured; fi
fi

# Pinned mdsmith; rules and conventions live in .mdsmith.yml.
mdsmith_pkg=github.com/jeduden/mdsmith/cmd/mdsmith@v0.57.0

mode=check
tells=0
readability=0
paths=()
path_args=0 # path arguments given, good or bad
bad_paths=0 # bad paths are reported, the rest still lint, and the run exits 2
for arg in "$@"; do
  case "$arg" in
    --tells) tells=1 ;;
    --readability) readability=1 ;;
    --autofix) mode=fix ;;
    -*) usage; exit 2 ;;
    *)
      path_args=$((path_args + 1))
      abs=$arg
      [[ $abs == /* ]] || abs="$start_dir/$abs"
      if [[ ! -e $abs ]]; then
        echo "bin/lint: no such path: $arg" >&2
        bad_paths=1
        continue
      fi
      # Lint paths are relative to the repository root, where we run.
      if [[ $abs == "$repo_root"/* ]]; then abs=${abs#"$repo_root"/}; fi
      paths+=("$abs")
      ;;
  esac
done

# Advisory tells mode: run only MDS055 and MDS056 from .mdsmith-tells.yml over
# the prose scope, print the findings and a stats line, and always exit 0. It
# never changes the default lint, and it takes no other options or paths.
if (( tells )); then
  if (( readability )) || [[ $mode != check ]] || (( path_args )); then
    echo "bin/lint: --tells takes no other options or paths" >&2
    usage
    exit 2
  fi
  scope=()
  for p in docs README.md "$tasks_dir/inbox" "$tasks_dir/ready" "$tasks_dir/active" "$tasks_dir/failed"; do
    if [[ -e $p ]]; then scope+=("$p"); fi
  done
  report=$(go run "$mdsmith_pkg" check --no-color -c .mdsmith-tells.yml \
    "${scope[@]}" 2>&1 || true)
  findings=$(printf '%s\n' "$report" | grep -E '^[^ ]+:[0-9]+:[0-9]+ MDS05[56] ' || true)
  [[ -z $findings ]] || printf '%s\n' "$findings"
  n55=$(printf '%s\n' "$findings" | grep -c ' MDS055 ' || true)
  n56=$(printf '%s\n' "$findings" | grep -c ' MDS056 ' || true)
  echo "stats: tells MDS055=$n55 MDS056=$n56"
  exit 0
fi

# Advisory readability mode (TF-039): run MDS023, MDS024 and MDS036 from
# .mdsmith-readability.yml over the files workers read, print the findings and
# a stats line, and always exit 0. It never changes the default lint.
if (( readability )); then
  if [[ $mode != check ]] || (( path_args )); then
    echo "bin/lint: --readability takes no other options or paths" >&2
    usage
    exit 2
  fi
  scope=()
  for p in "$tasks_dir/inbox" "$tasks_dir/ready" "$tasks_dir/active" "$tasks_dir/failed" \
    docs/worker-instructions.md docs/protocol-v1.md docs/task-format-v1.md \
    skills/taskfactory/SKILL.md README.md; do
    if [[ -e $p ]]; then scope+=("$p"); fi
  done
  report=$(go run "$mdsmith_pkg" check --no-color -c .mdsmith-readability.yml \
    "${scope[@]}" 2>&1 || true)
  findings=$(printf '%s\n' "$report" | grep -E '^[^ ]+:[0-9]+:[0-9]+ MDS(023|024|036) ' || true)
  [[ -z $findings ]] || printf '%s\n' "$findings"
  n23=$(printf '%s\n' "$findings" | grep -c ' MDS023 ' || true)
  n24=$(printf '%s\n' "$findings" | grep -c ' MDS024 ' || true)
  n36=$(printf '%s\n' "$findings" | grep -c ' MDS036 ' || true)
  echo "stats: readability MDS023=$n23 MDS024=$n24 MDS036=$n36"
  exit 0
fi

# is_shell FILE: a *.sh file, or a file whose first line is a bash/sh shebang.
is_shell() {
  local first re='^#!.*(bash|/sh)([[:space:]]|$)'
  [[ $1 == *.sh ]] && return 0
  [[ -f $1 ]] || return 1
  IFS= read -r first < "$1" || true
  [[ $first =~ $re ]]
}

# is_task_file PATH: a Markdown task file under the tasks directory, outside its
# archive.
# The archive is history and is not contract-checked.
is_task_file() {
  local p=${1#./}
  [[ $p == "$tasks_dir"/*.md && $p != "$tasks_dir"/archive/* ]]
}

# Collect Go, Bash, and Markdown targets. Directories are walked for Go and
# Bash; Markdown directories go to mdsmith, which walks them itself.
go_files=()
sh_files=()
md_targets=()
task_files=()
vet_pkgs=()
whole_project=0

if (( path_args == 0 )); then
  whole_project=1
  while IFS= read -r f; do go_files+=("${f#./}"); done < <(
    find . \( -name .git -o -name .claude -o -name .taskfactory -o -name node_modules \) -prune -o -name '*.go' -type f -print)
  while IFS= read -r f; do sh_files+=("${f#./}"); done < <(
    find . \( -name .git -o -name .claude -o -name .taskfactory -o -name node_modules \) -prune -o -name '*.sh' -type f -print)
  for f in bin/*; do
    if [[ -f $f ]] && is_shell "$f"; then sh_files+=("$f"); fi
  done
  vet_pkgs=("./...")
  if (( ${#go_files[@]} == 0 )); then vet_pkgs=(); fi
else
  for p in ${paths[@]+"${paths[@]}"}; do
    if [[ -d $p ]]; then
      md_targets+=("$p")
      while IFS= read -r f; do go_files+=("$f"); done < <(find "$p" -name '*.go' -type f)
      while IFS= read -r f; do sh_files+=("$f"); done < <(find "$p" -name '*.sh' -type f)
      if compgen -G "$p/*.go" >/dev/null; then vet_pkgs+=("./$p"); fi
    else
      case "$p" in
        *.md|*.markdown)
          # Task files get both halves in the task loop below, not the batch.
          if is_task_file "$p"; then
            task_files+=("$p")
          else
            md_targets+=("$p")
          fi
          ;;
        *.go) go_files+=("$p") ;;
        *)
          if is_shell "$p"; then
            sh_files+=("$p")
          else
            echo "bin/lint: no linter for path: $p" >&2
            bad_paths=1
          fi
          ;;
      esac
    fi
  done
fi

failed=0
md_status=0

# Markdown: mdsmith, pinned. Runs on the whole project or the given targets.
if (( whole_project )) || (( ${#md_targets[@]} )); then
  mdsmith_args=("$mode")
  if (( ! whole_project )); then mdsmith_args+=(${md_targets[@]+"${md_targets[@]}"}); fi
  go run "$mdsmith_pkg" "${mdsmith_args[@]}" || md_status=$?
fi

# Readability gate (TF-115): the worker-facing files a small model reads before
# every task also get MDS023, MDS024 and MDS036 in the default lint. Their
# thresholds come from .mdsmith-readability.yml, the one source. Other Markdown
# stays advisory (bin/lint --readability). These rules only report, so
# --autofix never changes them; the gate always runs in check mode.
gated_md=(docs/worker-instructions.md skills/taskfactory/SKILL.md)
gate_files=()
for gf in "${gated_md[@]}"; do
  [[ -e $gf ]] || continue
  if (( whole_project )); then gate_files+=("$gf"); continue; fi
  for p in ${paths[@]+"${paths[@]}"}; do
    if [[ $p == "$gf" || $gf == "$p"/* ]]; then gate_files+=("$gf"); break; fi
  done
done
if (( ${#gate_files[@]} )); then
  # mdsmith exits 1 on any finding, including non-readability ones; the grep
  # below decides, and the stats line shows that mdsmith ran.
  gate_report=$(go run "$mdsmith_pkg" check --no-color -c .mdsmith-readability.yml \
    "${gate_files[@]}" 2>&1 || true)
  gate_findings=$(printf '%s\n' "$gate_report" | grep -E '^[^ ]+:[0-9]+:[0-9]+ MDS(023|024|036) ' || true)
  if [[ -n $gate_findings ]]; then
    printf '%s\n' "$gate_findings" >&2
    echo "bin/lint: FAIL readability gate: ${gate_files[*]}" >&2
    failed=1
  elif ! printf '%s\n' "$gate_report" | grep -q '^stats: checked='; then
    printf '%s\n' "$gate_report" >&2
    echo "bin/lint: FAIL readability gate could not run mdsmith" >&2
    failed=1
  fi
fi

# Task files: each one gets the Markdown lint and then the contract validation.
# Both halves run even when the other fails, and each failure names the file.
for tf in ${task_files[@]+"${task_files[@]}"}; do
  md_file_status=0
  go run "$mdsmith_pkg" "$mode" "$tf" || md_file_status=$?
  if (( md_file_status != 0 )); then
    echo "bin/lint: FAIL markdown lint: $tf (mdsmith exit $md_file_status)" >&2
    if (( md_status == 0 )); then md_status=$md_file_status; fi
  fi
  if ! go run ./cmd/taskfactory validate "$tf"; then
    echo "bin/lint: FAIL task validation: $tf" >&2
    failed=1
  fi
done

# Whole project: whole-tree task validation runs after the Markdown lint. It
# needs the Go module, so it is skipped where there is none, as bin/test does.
if (( whole_project )); then
  if [[ -f go.mod ]]; then
    if ! go run ./cmd/taskfactory validate "$tasks_dir"; then
      echo "bin/lint: FAIL task validation: $tasks_dir" >&2
      failed=1
    fi
  else
    echo "SKIP: task validation (go.mod not found)" >&2
  fi
fi

# Go formatting: gofmt. gofmt exits 0 even when it lists files, so the
# listing itself decides the result.
if (( ${#go_files[@]} )); then
  if [[ $mode == fix ]]; then
    gofmt -w "${go_files[@]}" || failed=1
  fi
  if ! listed=$(gofmt -l "${go_files[@]}"); then
    echo "FAIL: gofmt could not parse the Go files" >&2
    failed=1
  fi
  if [[ -n $listed ]]; then
    printf 'FAIL: gofmt needs formatting:\n%s\n' "$listed" >&2
    failed=1
  fi
fi

# Go vet: per package. The whole project is "./...".
for pkg in ${vet_pkgs[@]+"${vet_pkgs[@]}"}; do
  go vet "$pkg" || failed=1
done

# Bash: shellcheck, only when installed.
if (( ${#sh_files[@]} )); then
  if command -v shellcheck >/dev/null 2>&1; then
    # -x follows sourced helpers, found next to the script that sources them.
    shellcheck -x -P SCRIPTDIR ${sh_files[@]+"${sh_files[@]}"} || failed=1
  else
    echo "SKIP: shellcheck not installed; Bash files were not linted" >&2
  fi
fi

if (( bad_paths )); then usage; exit 2; fi
if (( md_status != 0 )); then exit "$md_status"; fi
if (( failed )); then exit 1; fi
exit 0

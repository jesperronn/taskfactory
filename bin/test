#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd "${script_dir}/.." && pwd)
cd "${repo_root}"

export LC_ALL=C

# Limits from TF-087, enforced by --budget.
shell_case_limit=1.000 # seconds, per [TIME] case line
go_total_limit=5000    # milliseconds, for the selected Go packages

usage() {
  printf 'Usage: bin/test [--verbose] [--budget] [PATH...]\n' >&2
}

verbose=0
budget=0
paths=()
for arg in "$@"; do
  case "${arg}" in
    --verbose) verbose=1 ;;
    --budget) budget=1 ;;
    -*)
      usage
      exit 2
      ;;
    *) paths+=("${arg}") ;;
  esac
done

# normalize PATH: relative to the repository root, no leading ./ or trailing /.
# Prints nothing and fails for a path outside the repository.
normalize() {
  local p=${1#./}
  p=${p%/}
  case "${p}" in
    /*|../*|*/../*|..)
      printf 'bin/test: path must be inside the repository: %s\n' "$1" >&2
      return 1
      ;;
  esac
  printf '%s\n' "${p:-.}"
}

now_ms() {
  perl -MTime::HiRes=time -e 'printf "%d\n", time * 1000'
}

shell_tests=()
go_packages=()
bad_paths=0

# add_shell_test FILE and add_go_package PKG add to the lists once, so a test
# selected twice (a file and its folder) runs once.
add_shell_test() {
  local t
  for t in ${shell_tests[@]+"${shell_tests[@]}"}; do
    [[ "${t}" == "$1" ]] && return 0
  done
  shell_tests+=("$1")
}

add_go_package() {
  local t
  for t in ${go_packages[@]+"${go_packages[@]}"}; do
    [[ "${t}" == "$1" ]] && return 0
  done
  go_packages+=("$1")
}

# bad_path MESSAGE ARG: reports one bad path and goes on; the run exits 2 at
# the end, after every valid path has run.
bad_path() {
  printf 'bin/test: %s: %s\n' "$1" "$2" >&2
  bad_paths=1
}

# select_path PATH adds a shell test file, a folder of shell tests, a Go
# package folder or pattern, or the test of a source file to the lists. Any
# other path is reported as bad.
select_path() {
  local p file found=0 name
  if ! p=$(normalize "$1"); then
    bad_paths=1
    return 0
  fi
  if [[ "${p}" == *...* ]]; then
    add_go_package "./${p}"
  elif [[ "${p}" == *.test.sh ]]; then
    if [[ ! -f "${p}" ]]; then
      bad_path 'no such shell test file' "$1"
      return 0
    fi
    add_shell_test "${p}"
  elif [[ -d "${p}" ]]; then
    for file in "${p}"/*.test.sh; do
      [[ -f "${file}" ]] || continue
      add_shell_test "${file}"
      found=1
    done
    if (( ! found )); then
      for file in "${p}"/*.go; do
        [[ -f "${file}" ]] || continue
        found=2
        break
      done
      if (( found == 2 )); then
        add_go_package "./${p}"
      else
        bad_path 'no shell tests or Go package in' "$1"
      fi
    fi
  elif [[ -f "${p}" && "${p}" == *.go ]]; then
    add_go_package "./$(dirname "${p}")"
  elif [[ -f "${p}" && "${p}" == bin/* && "${p}" != */*/* ]]; then
    name=${p##*/}
    if [[ -f "bin/${name}.test.sh" ]]; then
      add_shell_test "bin/${name}.test.sh"
    elif [[ -f "bin/${name%.sh}.test.sh" ]]; then
      add_shell_test "bin/${name%.sh}.test.sh"
    else
      bad_path 'no test covers source file' "$1"
    fi
  else
    bad_path 'not a shell test, folder, Go package or source file with a test' "$1"
  fi
}

full_run=0
if (( ${#paths[@]} == 0 )); then
  # No paths: every shell test, the Go suite, and whole-tree validation.
  full_run=1
  for test_file in bin/*.test.sh; do
    [[ -f "${test_file}" ]] || continue
    shell_tests+=("${test_file}")
  done
  if [[ -f go.mod ]]; then
    go_packages+=("./...")
  fi
else
  for p in "${paths[@]}"; do
    select_path "${p}"
  done
  if (( bad_paths )); then usage; fi
fi

failed=0

# step_header TEXT prints "==> TEXT", in bold cyan when stdout is a terminal
# (or FORCE_COLOR is non-empty) and NO_COLOR is unset; plain otherwise.
step_header() {
  if [[ -z "${NO_COLOR:-}" ]] && { [[ -t 1 ]] || [[ -n "${FORCE_COLOR:-}" ]]; }; then
    printf '\033[1;36m==> %s\033[0m\n' "$1"
  else
    printf '==> %s\n' "$1"
  fi
}

# run_shell_test FILE runs one shell test, and checks its cases against the
# budget when --budget is set.
run_shell_test() {
  local test_file=$1 out slow status=0
  if [[ ! -x "${test_file}" ]]; then
    printf 'FAIL: shell test is not executable: %s\n' "${test_file}" >&2
    failed=1
    return
  fi
  step_header "${test_file}"
  if (( budget )); then
    out=$(mktemp)
    "./${test_file}" --verbose > "${out}" 2>&1 || status=$?
    cat "${out}"
    slow=$(awk '$1 == "[TIME]" && $3 != "total" {
      t = $2; sub(/s$/, "", t)
      if (t + 0 > '"${shell_case_limit}"') { print; bad = 1 }
    }
    END { exit bad }' "${out}") || true
    rm -f "${out}"
    if [[ -n "${slow}" ]]; then
      printf 'FAIL: budget: %s has cases over %ss:\n%s\n' "${test_file}" "${shell_case_limit}" "${slow}" >&2
      failed=1
    fi
    if (( status != 0 )); then
      printf 'FAIL: shell test: %s (rerun with: ./%s)\n' "${test_file}" "${test_file}" >&2
      failed=1
    fi
    return
  fi
  local test_args=()
  if (( verbose )); then
    test_args+=(--verbose)
  fi
  if ! "./${test_file}" ${test_args[@]+"${test_args[@]}"}; then
    printf 'FAIL: shell test: %s (rerun with: ./%s)\n' "${test_file}" "${test_file}" >&2
    failed=1
  fi
}

# run_go_tests PKG... runs go test for the packages and checks the total
# time against the budget when --budget is set.
run_go_tests() {
  local out start elapsed go_status=0 pkg_ms
  step_header "go test $*"
  if (( ! budget )); then
    if ! go test "$@"; then
      printf 'FAIL: Go tests: go test %s\n' "$*" >&2
      failed=1
    fi
    return
  fi
  out=$(mktemp)
  start=$(now_ms)
  go test -count=1 -json "$@" > "${out}" 2>&1 || go_status=$?
  elapsed=$(( $(now_ms) - start ))
  # A package that reports a longer time than the wall clock sets the total.
  pkg_ms=$(perl -MJSON::PP -e '
    my $max = 0;
    while (<STDIN>) {
      my $d = eval { JSON::PP::decode_json($_) };
      next unless ref $d eq "HASH" && !defined $d->{Test} && defined $d->{Elapsed};
      $max = $d->{Elapsed} if $d->{Elapsed} > $max;
    }
    printf "%d\n", $max * 1000;' < "${out}")
  if (( pkg_ms > elapsed )); then elapsed=${pkg_ms}; fi
  # Print the test output text from the JSON stream (non-JSON lines as is).
  perl -MJSON::PP -e '
    while (<STDIN>) {
      my $d = eval { JSON::PP::decode_json($_) };
      if (ref $d eq "HASH") { print $d->{Output} if defined $d->{Output}; }
      else { print; }
    }' < "${out}"
  if (( go_status != 0 )); then
    printf 'FAIL: Go tests: go test %s\n' "$*" >&2
    failed=1
  fi
  if (( elapsed > go_total_limit )); then
    printf 'FAIL: budget: Go tests took %sms, over the %sms limit; slowest tests:\n' "${elapsed}" "${go_total_limit}" >&2
    perl -MJSON::PP -e '
      while (<STDIN>) {
        my $d = eval { JSON::PP::decode_json($_) };
        next unless ref $d eq "HASH" && $d->{Test} && defined $d->{Elapsed};
        next unless $d->{Action} =~ /^(pass|fail)$/;
        printf "%.2fs %s %s\n", $d->{Elapsed}, $d->{Package} // "", $d->{Test};
      }' < "${out}" | sort -rn | head -5 >&2
    failed=1
  fi
  rm -f "${out}"
}

for test_file in ${shell_tests[@]+"${shell_tests[@]}"}; do
  run_shell_test "${test_file}"
done

if (( ${#go_packages[@]} )); then
  run_go_tests "${go_packages[@]}"
elif (( full_run )); then
  printf 'SKIP: Go tests (go.mod not found)\n'
fi

# Whole-tree validation runs only for a full run, never for selected paths.
if (( full_run )) && [[ -f go.mod ]]; then
  if [[ -f .taskfactory/config.toml ]]; then
    # The tasks directory is the top-level tasks_dir key, "tasks" by default.
    tasks_dir=tasks
    configured=$(sed -n 's/^[[:space:]]*tasks_dir[[:space:]]*=[[:space:]]*"\([^"]*\)".*$/\1/p;/^[[:space:]]*\[/q' \
      .taskfactory/config.toml | head -n 1)
    configured=${configured#./}
    configured=${configured%/}
    if [[ -n $configured ]]; then tasks_dir=$configured; fi
    step_header "go run ./cmd/taskfactory validate ${tasks_dir}"
    if ! go run ./cmd/taskfactory validate "$tasks_dir"; then
      printf 'FAIL: task validation: go run ./cmd/taskfactory validate %s\n' "$tasks_dir" >&2
      failed=1
    fi
  else
    printf 'FAIL: task validation: .taskfactory/config.toml is missing; run taskfactory init\n' >&2
    failed=1
  fi
fi

if (( bad_paths )); then
  exit 2
fi

if (( failed )); then
  exit 1
fi

printf 'TEST SUMMARY: all selected checks passed\n'
